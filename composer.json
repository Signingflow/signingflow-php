{
  "name": "signingflow/signingflow",
  "description": "Official PHP SDK for sending a document, reading envelope status, and verifying webhooks with the Signingflow API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "classmap": ["src/Signingflow"],
    "files": ["src/Signingflow/functions.php"]
  },
  "autoload-dev": {
    "classmap": ["tests"]
  },
  "config": {
    "sort-packages": true
  }
}
